<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 웹앱(https://utaegram.github.io/hwpx-viewer/)을 불러오기 위한 인터넷 권한 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 안드로이드 9(API 28) 이하에서 Downloads 폴더에 저장할 때만 필요 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize">

            <!-- 홈 화면 아이콘으로 실행 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ==================================================================
                 파일을 눌렀을 때 '연결 프로그램' 목록에 훈민정음이 뜨게 하는 필터들.

                 Android 규칙상 한 <intent-filter> 안에 pathPattern 과 mimeType 이
                 같이 있으면 '그 둘을 모두 만족'해야 하므로(AND), 확장자가 경로에 없는
                 content:// URI(삼성 내 파일·카카오톡 등)가 떨어져 나간다.
                 그래서 MIME 만 보는 필터 / 확장자+MIME 을 같이 보는 필터 /
                 확장자만 보는 필터를 각각 따로 둔다.
                 ================================================================== -->

            <!-- 필터 1 — MIME 타입 전용. pathPattern 을 절대 넣지 않는다.
                 (확장자가 없는 content:// URI 이고 타입만 알려 주는 앱용) -->
            <intent-filter android:label="훈민정음으로 열기">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />

                <data android:mimeType="application/x-hwp" />
                <data android:mimeType="application/haansofthwp" />
                <data android:mimeType="application/vnd.hancom.hwp" />
                <data android:mimeType="application/vnd.hancom.hwpx" />
                <data android:mimeType="application/hwpx+zip" />
                <data android:mimeType="application/hwp+zip" />
                <data android:mimeType="application/hwp" />
                <data android:mimeType="application/hwpx" />
                <data android:mimeType="application/haansofthwpx" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <!-- 1.2 추가 — 파일 제공자(내 파일·카카오톡·다운로드 등)가 실제로 붙여 보내는 타입들 -->
                <data android:mimeType="application/vnd.haansoft-hwp" />
                <data android:mimeType="application/x-hwp+zip" />
                <data android:mimeType="application/x-hwpx" />
                <data android:mimeType="binary/octet-stream" />
                <data android:mimeType="application/x-download" />
                <data android:mimeType="application/download" />
                <data android:mimeType="application/force-download" />
                <data android:mimeType="application/unknown" />
            </intent-filter>

            <!-- 필터 2 — 확장자(pathPattern) + mimeType="*/*".
                 "*/*" 는 이 필터에서만 쓴다. pathPattern 과 함께 있으므로 실제로는
                 .hwp/.hwpx 경로만 걸러진다(모든 파일에 뜨지 않음). -->
            <intent-filter android:label="훈민정음으로 열기">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.hwp" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.hwpx" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.HWP" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.HWPX" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\..*\\.hwp" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\..*\\.hwpx" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\..*\\.HWP" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\..*\\.HWPX" />

                <data android:scheme="file" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.hwp" />
                <data android:scheme="file" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.hwpx" />
                <data android:scheme="file" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.HWP" />
                <data android:scheme="file" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.HWPX" />
                <data android:scheme="file" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\..*\\.hwp" />
                <data android:scheme="file" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\..*\\.hwpx" />
                <data android:scheme="file" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\..*\\.HWP" />
                <data android:scheme="file" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\..*\\.HWPX" />
            </intent-filter>

            <!-- 필터 3 — 확장자만. 타입을 아예 넣지 않고 setData(uri) 만 호출하는
                 파일 앱(content:// , file://)을 위한 것. -->
            <intent-filter android:label="훈민정음으로 열기">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.hwp" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.hwpx" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.HWP" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.HWPX" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\..*\\.hwp" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\..*\\.hwpx" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\..*\\.HWP" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\..*\\.HWPX" />

                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.hwp" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.hwpx" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.HWP" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.HWPX" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\..*\\.hwp" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\..*\\.hwpx" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\..*\\.HWP" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\..*\\.HWPX" />
            </intent-filter>

            <!-- 공유하기 시트에서 '훈민정음'으로 바로 보내기 (한 파일 / 여러 파일) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-hwp" />
                <data android:mimeType="application/haansofthwp" />
                <data android:mimeType="application/vnd.hancom.hwp" />
                <data android:mimeType="application/vnd.hancom.hwpx" />
                <data android:mimeType="application/hwpx+zip" />
                <data android:mimeType="application/hwp+zip" />
                <data android:mimeType="application/hwp" />
                <data android:mimeType="application/hwpx" />
                <data android:mimeType="application/haansofthwpx" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <!-- 1.2 추가 -->
                <data android:mimeType="application/vnd.haansoft-hwp" />
                <data android:mimeType="application/x-hwp+zip" />
                <data android:mimeType="application/x-hwpx" />
                <data android:mimeType="binary/octet-stream" />
                <data android:mimeType="application/x-download" />
                <data android:mimeType="application/download" />
                <data android:mimeType="application/force-download" />
                <data android:mimeType="application/unknown" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-hwp" />
                <data android:mimeType="application/haansofthwp" />
                <data android:mimeType="application/vnd.hancom.hwp" />
                <data android:mimeType="application/vnd.hancom.hwpx" />
                <data android:mimeType="application/hwpx+zip" />
                <data android:mimeType="application/hwp+zip" />
                <data android:mimeType="application/hwp" />
                <data android:mimeType="application/hwpx" />
                <data android:mimeType="application/haansofthwpx" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <!-- 1.2 추가 -->
                <data android:mimeType="application/vnd.haansoft-hwp" />
                <data android:mimeType="application/x-hwp+zip" />
                <data android:mimeType="application/x-hwpx" />
                <data android:mimeType="binary/octet-stream" />
                <data android:mimeType="application/x-download" />
                <data android:mimeType="application/download" />
                <data android:mimeType="application/force-download" />
                <data android:mimeType="application/unknown" />
            </intent-filter>
        </activity>
    </application>
</manifest>
