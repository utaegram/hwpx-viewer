<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 웹앱(https://utaegram.github.io/hwpx-viewer/)을 불러오기 위한 인터넷 권한 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 안드로이드 9(API 28) 이하에서 Downloads 폴더에 저장할 때만 필요 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustResize">

            <!-- 홈 화면 아이콘으로 실행 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 파일 관리자·메일·메신저에서 .hwp / .hwpx 를 누르면 '연결 프로그램'에 뜬다.
                 확장자(pathPattern) 필터와 MIME 필터를 함께 둔다: 파일 관리자는 확장자로,
                 다운로드·메일 앱은 MIME 으로 물어보기 때문이다. -->
            <intent-filter android:label="훈민정음으로 열기">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.hwp" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.hwpx" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.HWP" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.HWPX" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.hwp" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.hwpx" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.HWP" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.HWPX" />

                <data android:mimeType="application/x-hwp" />
                <data android:mimeType="application/haansofthwp" />
                <data android:mimeType="application/vnd.hancom.hwp" />
                <data android:mimeType="application/vnd.hancom.hwpx" />
                <data android:mimeType="application/hwpx+zip" />
                <data android:mimeType="application/hwp+zip" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
            </intent-filter>

            <!-- 공유하기 시트에서 '훈민정음'으로 바로 보내기 (한 파일 / 여러 파일) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-hwp" />
                <data android:mimeType="application/haansofthwp" />
                <data android:mimeType="application/vnd.hancom.hwp" />
                <data android:mimeType="application/vnd.hancom.hwpx" />
                <data android:mimeType="application/hwpx+zip" />
                <data android:mimeType="application/hwp+zip" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-hwp" />
                <data android:mimeType="application/haansofthwp" />
                <data android:mimeType="application/vnd.hancom.hwp" />
                <data android:mimeType="application/vnd.hancom.hwpx" />
                <data android:mimeType="application/hwpx+zip" />
                <data android:mimeType="application/hwp+zip" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
            </intent-filter>
        </activity>
    </application>
</manifest>
